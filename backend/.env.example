# Comma-separated list of origins allowed to call this API from a browser.
# Set to your deployed frontend URL(s); "*" is fine for local dev only.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Shared secret the ESP32-CAM and ESP32 pump controller send as the
# X-Device-Key header. Leave blank locally to skip the check; always set
# this in production so strangers can't hit /api/pump/command or spoof
# camera detections that trigger the pump.
DEVICE_API_KEY=change-me-to-a-long-random-string
